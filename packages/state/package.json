    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "zustand": "^5.1.0"
  }
}
