{
  "name": "@kitr/state",
  "version": "0.1.0",
  "description": "kitr/state: Zustand re-exported, plus an SSR-safe store factory.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
