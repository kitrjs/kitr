{
  "name": "@kitr/mocks",
  "version": "0.9.2",
  "description": "@kitr/mocks: MSW handlers from kitr contracts, for dev and tests.",
  "kitr": {
    "name": "mocks",
    "title": "Mocks",
    "summary": "Fake your API while you build the frontend or run tests.",
    "category": "dev-tools",
    "runsOn": "client",
    "builtOn": [
      "msw"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/mocks"
  },
  "homepage": "https://kitr.dev/packages/mocks",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "msw": ">=2.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "msw": "^3.0.4",
    "@types/node": "^22.19.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
