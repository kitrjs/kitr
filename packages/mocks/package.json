{
  "name": "@kitr/mocks",
  "version": "0.1.0",
  "description": "kitr/mocks: MSW handlers from kitr contracts, for dev and tests.",
  "kitr": {
    "name": "mocks",
    "title": "Mocks",
    "summary": "Fake your API while you build the frontend or run tests.",
    "category": "dev-tools",
    "runsOn": "client",
    "builtOn": [
      "msw"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "msw": ">=2.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "msw": "^3.0.4",
    "@types/node": "^22.19.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
