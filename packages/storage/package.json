{
  "name": "@kitr/storage",
  "version": "0.8.0",
  "description": "@kitr/storage: typed localStorage/sessionStorage items and cookies with one API on the client and the server; SSR-safe React hooks.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/storage"
  },
  "homepage": "https://kitr.dev/packages/storage",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "h3": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@kitr/devtools": "workspace:*",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "h3": "^2.0.8",
    "@types/node": "^22.19.0",
    "react-dom": "^19.3.1"
  },
  "kitr": {
    "name": "storage",
    "title": "Storage",
    "summary": "Save small values in the browser or in cookies with types, and read the same cookies on the server.",
    "category": "device",
    "runsOn": "both",
    "builtOn": [
      "localStorage",
      "cookies"
    ],
    "docs": "docs",
    "setup": "./kitr"
  }
}
