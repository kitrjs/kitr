{
  "name": "@kitr/capacitor",
  "version": "0.1.0",
  "description": "kitr/capacitor: platform helpers, app-state and back-button hooks, and typed plugin access for Capacitor apps.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@capacitor/core": ">=6.0.0",
    "@capacitor/app": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/app": "^8.1.2"
  },
  "kitr": {
    "name": "capacitor",
    "title": "Capacitor",
    "summary": "Ship your app to the iPhone and Android app stores, with hooks for the back button and app state.",
    "category": "platforms",
    "runsOn": "client",
    "builtOn": [
      "Capacitor"
    ],
    "client": true,
    "docs": "docs"
  }
}
