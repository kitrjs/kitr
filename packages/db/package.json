{
  "name": "@kitr/db",
  "version": "0.1.0",
  "description": "kitr/db: bind any ORM (Drizzle, Prisma, Kysely) as ctx.db with lifecycle hooks. No ORM shipped.",
  "kitr": {
    "name": "db",
    "title": "Database",
    "summary": "Connect your database so every request can use it.",
    "category": "backend",
    "runsOn": "server",
    "requires": [
      "server"
    ],
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
