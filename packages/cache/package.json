{
  "name": "@kitr/cache",
  "version": "0.1.0",
  "description": "kitr/cache: a tagged server cache with TTLs, a memory driver and a driver interface for Redis and friends; remember() around slow work.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  },
  "kitr": {
    "name": "cache",
    "title": "Cache",
    "summary": "Remember slow results on the server and clear them by tag when the data changes.",
    "category": "backend",
    "runsOn": "server",
    "requires": [
      "server"
    ],
    "docs": "docs"
  }
}
