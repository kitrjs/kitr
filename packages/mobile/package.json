{
  "name": "@kitr/mobile",
  "version": "0.1.0",
  "description": "kitr/mobile: the iOS and Android platform on Capacitor. Native projects in platforms/<name>/, drivers for storage and device capabilities, lifecycle hooks.",
  "kitr": {
    "name": "mobile",
    "title": "Mobile",
    "summary": "Ship the same app to iPhone and Android, with every kitr package switched to its native version.",
    "category": "platforms",
    "runsOn": "client",
    "builtOn": [
      "Capacitor"
    ],
    "requires": [
      "router",
      "platform",
      "storage"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/platform": "workspace:*",
    "@kitr/storage": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@capacitor/core": ">=6.0.0",
    "@capacitor/app": ">=6.0.0",
    "@capacitor/preferences": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/preferences": "^8.0.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
