{
  "name": "@kitr/ui",
  "version": "0.1.0",
  "description": "kitr/ui: theme provider, toasts, tokens and the registry config. Owned components live in your app.",
  "kitr": {
    "name": "ui",
    "title": "UI",
    "summary": "Ready-made buttons, dialogs and pages you copy into your app, plus dark mode and toasts.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "shadcn/ui"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/react": "workspace:*",
    "@kitr/styling": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "sonner": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "sonner": "^2.0.8"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
