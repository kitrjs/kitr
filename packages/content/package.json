{
  "name": "@kitr/content",
  "version": "0.5.0",
  "description": "@kitr/content: markdown collections rendered at build time (Shiki, callouts, steps, a table of contents), typed page loaders, search, llms.txt and React components for docs pages.",
  "kitr": {
    "name": "content",
    "title": "Content",
    "summary": "Write pages in markdown and get a docs site: highlighted code, a sidebar, search and copies for coding agents.",
    "category": "pages",
    "runsOn": "both",
    "builtOn": [
      "unified",
      "shiki"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr",
    "types": "./types"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/content"
  },
  "homepage": "https://kitr.dev/packages/content",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "jiti": "^2.7.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.23.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "peerDependencies": {
    "@kitr/router": "workspace:*",
    "react": ">=18.0.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@kitr/router": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kitr/router": "workspace:*",
    "@kitr/react": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
