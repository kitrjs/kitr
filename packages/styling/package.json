{
  "name": "@kitr/styling",
  "version": "0.1.0",
  "description": "kitr/styling: cx, cva, design tokens as CSS variables and typed CSS-module helpers. Works with any CSS approach.",
  "kitr": {
    "name": "styling",
    "title": "Styling",
    "summary": "Style with plain CSS or CSS modules, for apps that skip Tailwind.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "clsx",
      "class-variance-authority"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
