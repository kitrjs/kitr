{
  "name": "@kitr/kit-mobile",
  "version": "0.5.0",
  "description": "kitr new --kit mobile: The app kit as an installable PWA and a Capacitor shell: online state, install prompt, native lifecycle hooks.",
  "kitr": {
    "name": "mobile",
    "title": "Mobile kit",
    "summary": "Start the app kit as an installable PWA and a Capacitor shell with native lifecycle hooks.",
    "category": "kits",
    "runsOn": "both",
    "kind": "kit",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/kit-mobile"
  },
  "homepage": "https://kitr.dev/docs/cli",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "sideEffects": false,
  "exports": {
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kitr",
    "kitr-package",
    "kitr-kit"
  ],
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
