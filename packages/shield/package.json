{
  "name": "@kitr/shield",
  "version": "0.1.0",
  "description": "@kitr/shield: security headers, CORS, CSRF double-submit cookies and rate limiting as h3 middleware, configured in config/shield.ts.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/shield"
  },
  "homepage": "https://kitr.dev/packages/shield",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "h3": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "h3": "^2.0.8",
    "@types/node": "^22.19.0",
    "@kitr/server": "workspace:*",
    "@kitr/logger": "workspace:*"
  },
  "kitr": {
    "name": "shield",
    "title": "Shield",
    "summary": "Turn on the security basics every API needs: CORS, CSRF protection, safe headers and rate limits.",
    "category": "backend",
    "runsOn": "server",
    "requires": [
      "server"
    ],
    "docs": "docs",
    "setup": "./kitr"
  }
}
