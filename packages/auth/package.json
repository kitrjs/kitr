{
  "name": "@kitr/auth",
  "version": "0.1.0",
  "description": "kitr/auth: one session interface, adapters (token, Better Auth, custom), route guards and API middleware.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@kitr/api": "workspace:*",
    "@kitr/http": "workspace:*",
    "ky": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@kitr/api": {
      "optional": true
    },
    "@kitr/http": {
      "optional": true
    },
    "ky": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "@kitr/api": "workspace:*",
    "@kitr/http": "workspace:*",
    "ky": "^2.2.0",
    "h3": "^2.0.8",
    "@types/node": "^22.19.0",
    "@kitr/react": "workspace:*",
    "react-dom": "^19.3.1"
  }
}
