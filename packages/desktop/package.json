{
  "name": "@kitr/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "@kitr/desktop: the desktop platform with an Electron shell. Main and preload in platforms/<name>/, typed IPC, storage drivers, packaging with electron-builder.",
  "kitr": {
    "name": "desktop",
    "title": "Desktop",
    "summary": "Ship the same app to Windows, macOS and Linux in an Electron shell: Chromium ships with the app, so it renders the same everywhere.",
    "category": "platforms",
    "runsOn": "client",
    "builtOn": [
      "electron-vite",
      "electron-builder"
    ],
    "requires": [
      "vite",
      "router",
      "platform",
      "storage"
    ],
    "client": true,
    "docs": "docs",
    "kind": "platform",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/desktop"
  },
  "homepage": "https://kitr.dev/packages/desktop",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/platform": "workspace:*",
    "@kitr/storage": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "electron": ">=30.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "electron": "^45.2.3"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
