{
  "name": "@kitr/kit-saas",
  "version": "0.5.0",
  "description": "kitr new --kit saas: A logged-in product on its own API: sign-in, a guarded app shell, a projects CRUD with a data table, analytics and monitoring. Server-rendered web plus an API server.",
  "kitr": {
    "name": "saas",
    "title": "SaaS kit",
    "summary": "Start a logged-in product on its own API: sign-in, a guarded shell, a projects CRUD, analytics.",
    "category": "kits",
    "runsOn": "both",
    "kind": "kit",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/kit-saas"
  },
  "homepage": "https://kitr.dev/docs/cli",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kitr",
    "kitr-package",
    "kitr-kit"
  ],
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
