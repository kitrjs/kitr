{
  "name": "@kitr/socket.io",
  "version": "0.1.0",
  "description": "kitr/socket.io: the same channel contract over Socket.IO, client and server.",
  "kitr": {
    "name": "socket.io",
    "title": "Socket.IO",
    "summary": "The same live updates, over Socket.IO if your infrastructure already uses it.",
    "category": "realtime",
    "runsOn": "both",
    "builtOn": [
      "socket.io"
    ],
    "requires": [
      "server",
      "socket"
    ],
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/socket": "workspace:*"
  },
  "peerDependencies": {
    "socket.io": ">=4.7.0",
    "socket.io-client": ">=4.7.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "@types/node": "^22.19.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
