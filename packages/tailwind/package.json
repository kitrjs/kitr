{
  "name": "@kitr/tailwind",
  "version": "0.5.0",
  "description": "@kitr/tailwind: Tailwind v4 wiring, the kitr preset (tokens as @theme) and a tailwind-merge aware cn().",
  "kitr": {
    "name": "tailwind",
    "title": "Tailwind",
    "summary": "Style with Tailwind CSS classes, already set up with kitr's colours.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "tailwindcss"
    ],
    "requires": [
      "react"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/tailwind"
  },
  "homepage": "https://kitr.dev/packages/tailwind",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./preset.css": "./preset.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "preset.css",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "@tailwindcss/vite": ">=4.0.0",
    "vite": ">=6.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "vite": "^8.3.6"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
