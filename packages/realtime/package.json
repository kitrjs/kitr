{
  "name": "@kitr/realtime",
  "version": "0.3.2",
  "description": "@kitr/realtime: typed channels with interchangeable transports (WebSocket, Socket.IO, SSE). One definition for both ends; events apply cache effects.",
  "kitr": {
    "name": "realtime",
    "title": "Realtime",
    "summary": "Define a live channel once and push updates to every open screen, over WebSockets, Socket.IO or server events.",
    "category": "realtime",
    "runsOn": "both",
    "builtOn": [
      "crossws",
      "partysocket",
      "socket.io"
    ],
    "requires": [
      "server"
    ],
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/realtime"
  },
  "homepage": "https://kitr.dev/packages/realtime",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./socket.io": {
      "types": "./dist/socket-io.d.ts",
      "default": "./dist/socket-io.js"
    },
    "./socket.io/server": {
      "types": "./dist/socket-io-server.d.ts",
      "default": "./dist/socket-io-server.js"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./dist/sse.js"
    },
    "./sse/server": {
      "types": "./dist/sse-server.d.ts",
      "default": "./dist/sse-server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "partysocket": ">=1.0.0",
    "crossws": ">=0.4.0",
    "h3": ">=2.0.0",
    "socket.io": ">=4.0.0",
    "socket.io-client": ">=4.0.0",
    "@kitr/query": "workspace:*",
    "@kitr/server": "workspace:*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "partysocket": {
      "optional": true
    },
    "crossws": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "@kitr/query": {
      "optional": true
    },
    "@kitr/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "partysocket": "^1.3.0",
    "crossws": "^0.4.17",
    "h3": "^2.0.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "@kitr/query": "workspace:*",
    "@kitr/server": "workspace:*",
    "@kitr/logger": "workspace:*"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
