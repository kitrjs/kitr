{
  "name": "@kitr/table",
  "version": "0.7.0",
  "description": "@kitr/table: TanStack Table re-exported, plus URL-bound table state.",
  "kitr": {
    "name": "table",
    "title": "Tables",
    "summary": "Show rows of data with sorting, paging and filters that stay in the URL.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "@tanstack/react-table"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/table"
  },
  "homepage": "https://kitr.dev/packages/table",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@tanstack/react-table": "^9.3.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "@tanstack/react-table": "^9.3.1"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
