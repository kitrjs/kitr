{
  "name": "@kitr/kit-site",
  "version": "0.6.0",
  "description": "kitr new --kit site: A marketing site: server-rendered with prerendering, SEO heads, i18n (en/de), a blog and a newsletter form on a controller.",
  "kitr": {
    "name": "site",
    "title": "Site kit",
    "summary": "Start a marketing site: server-rendered, prerendered, SEO heads, i18n, a blog and a newsletter form.",
    "category": "kits",
    "runsOn": "both",
    "kind": "kit",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/kit-site"
  },
  "homepage": "https://kitr.dev/docs/cli",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kitr",
    "kitr-package",
    "kitr-kit"
  ],
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
