{
  "name": "@kitr/updater",
  "version": "0.1.0",
  "private": true,
  "description": "@kitr/updater: one check/apply API for new versions: the service worker on the web, Tauri and Electron updaters on desktop, the store or live update on mobile.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/updater"
  },
  "homepage": "https://kitr.dev/packages/updater",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./drivers/web": {
      "types": "./dist/drivers/web.d.ts",
      "default": "./dist/drivers/web.js"
    },
    "./drivers/electron": {
      "types": "./dist/drivers/electron.d.ts",
      "default": "./dist/drivers/electron.js"
    },
    "./drivers/tauri": {
      "types": "./dist/drivers/tauri.d.ts",
      "default": "./dist/drivers/tauri.js"
    },
    "./drivers/capacitor": {
      "types": "./dist/drivers/capacitor.d.ts",
      "default": "./dist/drivers/capacitor.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/platform": "workspace:*",
    "@kitr/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@capacitor/core": ">=7.0.0",
    "@capawesome/capacitor-app-update": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capawesome/capacitor-app-update": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "react-dom": "^19.3.1",
    "@kitr/react": "workspace:*",
    "@capacitor/core": "^8.6.0",
    "@capawesome/capacitor-app-update": "^8.1.1"
  },
  "kitr": {
    "name": "updater",
    "title": "Updater",
    "summary": "Tell people a new version is ready and update the app in place, on the web, desktop and mobile.",
    "category": "platforms",
    "runsOn": "client",
    "requires": [
      "platform"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  }
}
