{
  "name": "@kitr/files",
  "version": "0.2.1",
  "description": "@kitr/files: open, save and pick files through one API with native dialogs on desktop and mobile and a download fallback on the web.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/files"
  },
  "homepage": "https://kitr.dev/packages/files",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./drivers/web": {
      "types": "./dist/drivers/web.d.ts",
      "default": "./dist/drivers/web.js"
    },
    "./drivers/electron": {
      "types": "./dist/drivers/electron.d.ts",
      "default": "./dist/drivers/electron.js"
    },
    "./drivers/tauri": {
      "types": "./dist/drivers/tauri.d.ts",
      "default": "./dist/drivers/tauri.js"
    },
    "./drivers/capacitor": {
      "types": "./dist/drivers/capacitor.d.ts",
      "default": "./dist/drivers/capacitor.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/platform": "workspace:*",
    "@kitr/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@capacitor/core": ">=7.0.0",
    "@capacitor/filesystem": ">=7.0.0",
    "@capacitor/share": ">=7.0.0",
    "@capawesome/capacitor-file-picker": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/filesystem": {
      "optional": true
    },
    "@capacitor/share": {
      "optional": true
    },
    "@capawesome/capacitor-file-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "react-dom": "^19.3.1",
    "@kitr/react": "workspace:*",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.1"
  },
  "kitr": {
    "name": "files",
    "title": "Files",
    "summary": "Let people open, save and pick files on any platform, with a download fallback in older browsers.",
    "category": "device",
    "runsOn": "client",
    "requires": [
      "platform"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  }
}
