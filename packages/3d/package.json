{
  "name": "@kitr/3d",
  "version": "0.5.0",
  "description": "@kitr/3d: React Three Fiber and drei re-exported, plus a Scene that degrades without WebGL, pauses off screen and adapts its resolution, theme colours for materials and offline model decoders.",
  "kitr": {
    "name": "3d",
    "title": "3D",
    "summary": "Render 3D scenes and models that stay smooth on phones and fall back when WebGL is missing.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "@react-three/fiber",
      "three"
    ],
    "requires": [
      "react"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/3d"
  },
  "homepage": "https://kitr.dev/packages/3d",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drei": {
      "types": "./dist/drei.d.ts",
      "default": "./dist/drei.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
