{
  "name": "@kitr/notifications",
  "version": "0.4.0",
  "description": "@kitr/notifications: permission, local and scheduled notifications with a tap that opens the right page, on the web and in native shells.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/notifications"
  },
  "homepage": "https://kitr.dev/packages/notifications",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "default": "./dist/driver.js"
    },
    "./drivers/web": {
      "types": "./dist/drivers/web.d.ts",
      "default": "./dist/drivers/web.js"
    },
    "./drivers/electron": {
      "types": "./dist/drivers/electron.d.ts",
      "default": "./dist/drivers/electron.js"
    },
    "./drivers/tauri": {
      "types": "./dist/drivers/tauri.d.ts",
      "default": "./dist/drivers/tauri.js"
    },
    "./drivers/capacitor": {
      "types": "./dist/drivers/capacitor.d.ts",
      "default": "./dist/drivers/capacitor.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/platform": "workspace:*",
    "@kitr/react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@capacitor/core": ">=7.0.0",
    "@capacitor/local-notifications": ">=7.0.0",
    "@capacitor/push-notifications": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/local-notifications": {
      "optional": true
    },
    "@capacitor/push-notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "react-dom": "^19.3.1",
    "@kitr/react": "workspace:*",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3"
  },
  "kitr": {
    "name": "notifications",
    "title": "Notifications",
    "summary": "Ask for permission and show local or scheduled notifications that open the right page when tapped.",
    "category": "device",
    "runsOn": "client",
    "requires": [
      "platform"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  }
}
