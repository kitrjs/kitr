{
  "name": "@kitr/i18n",
  "version": "0.1.0",
  "description": "kitr/i18n: react-i18next re-exported, plus typed keys and locale helpers.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "i18next": ">=23.0.0",
    "react-i18next": ">=15.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "i18next": "^27.0.0",
    "react-i18next": "^18.0.0"
  }
}
