{
  "name": "@kitr/i18n",
  "version": "0.1.0",
  "description": "kitr/i18n: react-i18next re-exported, plus typed keys and locale helpers.",
  "kitr": {
    "name": "i18n",
    "title": "Translations",
    "summary": "Translate your app into several languages with typed keys.",
    "category": "interface",
    "runsOn": "client",
    "builtOn": [
      "react-i18next"
    ],
    "client": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://kitr.dev/packages/i18n",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "i18next": ">=23.0.0",
    "react-i18next": ">=15.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "i18next": "^27.0.0",
    "react-i18next": "^18.0.0",
    "@kitr/react": "workspace:*"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
