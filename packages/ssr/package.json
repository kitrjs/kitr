{
  "name": "@kitr/ssr",
  "version": "0.1.0",
  "description": "kitr/ssr: per-route rendering defaults, SEO head helpers and prerender config for TanStack Start apps.",
  "kitr": {
    "name": "ssr",
    "title": "SSR and SEO",
    "summary": "Render pages on the server for fast first loads and good search ranking.",
    "category": "pages",
    "runsOn": "both",
    "builtOn": [
      "@tanstack/react-start"
    ],
    "requires": [
      "server"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1.120.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
