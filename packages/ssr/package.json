    "@tanstack/react-router": ">=1.120.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
