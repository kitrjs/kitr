{
  "name": "@kitr/kit-dashboard",
  "version": "0.2.1",
  "description": "kitr new --kit dashboard: A logged-in app on an external API: http, forms, tables, state, theme, tailwind, auth, mocks, testing.",
  "kitr": {
    "name": "dashboard",
    "title": "Dashboard kit",
    "summary": "Start a logged-in app on an external API: forms, tables, state, theme, auth, mocks and tests.",
    "category": "kits",
    "runsOn": "both",
    "kind": "kit",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/kit-dashboard"
  },
  "homepage": "https://kitr.dev/docs/cli",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kitr",
    "kitr-package",
    "kitr-kit"
  ],
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
