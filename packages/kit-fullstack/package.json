{
  "name": "@kitr/kit-fullstack",
  "version": "0.2.0",
  "description": "kitr new --kit fullstack: The app kit plus a server-rendered web platform, an API server, actions, api and realtime channels.",
  "kitr": {
    "name": "fullstack",
    "title": "Fullstack kit",
    "summary": "Start the app kit with a server-rendered site, an API server, actions and realtime channels.",
    "category": "kits",
    "runsOn": "both",
    "kind": "kit",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/kit-fullstack"
  },
  "homepage": "https://kitr.dev/docs/cli",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "kitr",
    "kitr-package",
    "kitr-kit"
  ],
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
