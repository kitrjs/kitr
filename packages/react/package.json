{
  "name": "@kitr/react",
  "version": "0.9.1",
  "description": "React bindings for the kitr app: <KitrProvider>, useApp(), useService().",
  "kitr": {
    "name": "react",
    "title": "React",
    "summary": "React with the kitr app in context, so every component can reach services and config.",
    "category": "pages",
    "runsOn": "client",
    "builtOn": [
      "react"
    ],
    "client": true,
    "included": true,
    "docs": "docs",
    "setup": "./kitr"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/react"
  },
  "homepage": "https://kitr.dev/packages/react",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kitr": {
      "types": "./dist/kitr.d.ts",
      "default": "./dist/kitr.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "react": "^19.3.1",
    "@types/react": "^19.3.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
