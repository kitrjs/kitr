{
  "name": "@kitr/actions",
  "version": "0.1.0",
  "description": "kitr/actions: defineAction over TanStack Start server functions, with validation, middleware, the kitr error shape and cache effects.",
  "kitr": {
    "name": "actions",
    "title": "Server actions",
    "summary": "Call server code straight from a component, like a form submit, without writing an API route.",
    "category": "backend",
    "runsOn": "both",
    "builtOn": [
      "@tanstack/react-start"
    ],
    "requires": [
      "server"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.120.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "vite": "^8.3.6"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
