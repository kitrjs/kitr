  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.120.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "vite": "^8.3.6"
  }
}
