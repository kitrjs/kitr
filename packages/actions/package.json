{
  "name": "@kitr/actions",
  "version": "0.1.0",
  "description": "kitr/actions: defineQuery and defineMutation over TanStack Start server functions, with validation, middleware, the kitr error shape and cache effects.",
  "kitr": {
    "name": "actions",
    "title": "Server actions",
    "summary": "Call server code straight from a component, like a form submit, without writing an API route.",
    "category": "backend",
    "runsOn": "both",
    "builtOn": [
      "@tanstack/react-start"
    ],
    "requires": [
      "server",
      "query"
    ],
    "client": true,
    "docs": "docs",
    "types": "./types"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitrjs/kitr.git",
    "directory": "packages/actions"
  },
  "homepage": "https://kitr.dev/packages/actions",
  "bugs": "https://github.com/kitrjs/kitr/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*",
    "@kitr/query": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.120.0",
    "@tanstack/react-query": ">=5.80.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "@types/react": "^19.3.0",
    "vite": "^8.3.6",
    "@tanstack/react-query": "^5.107.1"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
