{
  "name": "@kitr/electron",
  "version": "0.1.0",
  "description": "kitr/electron: typed IPC across main, preload and renderer, a main-window helper, and the electron-vite wiring.",
  "keywords": [
    "kitr",
    "kitr-package"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "electron": "^45.2.3",
    "@types/node": "^22.19.0"
  },
  "kitr": {
    "name": "electron",
    "title": "Electron",
    "summary": "Ship your app as a desktop program for Windows, macOS and Linux, with typed calls into the system.",
    "category": "platforms",
    "runsOn": "client",
    "builtOn": [
      "Electron",
      "electron-vite"
    ],
    "client": true,
    "docs": "docs"
  }
}
