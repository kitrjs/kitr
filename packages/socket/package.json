{
  "name": "@kitr/socket",
  "version": "0.1.0",
  "description": "kitr/socket: typed channels over native WebSocket. Client on partysocket, server on crossws via h3. Events land in the query cache.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "crossws": ">=0.4.0",
    "h3": ">=2.0.0",
    "partysocket": ">=1.0.0"
  },
  "devDependencies": {
    "@kitr/server": "workspace:*",
    "@types/node": "^22.19.0",
    "crossws": "^0.4.17",
    "h3": "^2.0.8",
    "partysocket": "^1.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "@kitr/logger": "workspace:*"
  }
}
