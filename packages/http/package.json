{
  "name": "@kitr/http",
  "version": "0.1.0",
  "description": "kitr/http: ky re-exported, plus a client with auth, refresh and kitr error normalisation.",
  "kitr": {
    "name": "http",
    "title": "HTTP client",
    "summary": "Call a REST API with login tokens added for you and errors in one shape.",
    "category": "data-fetching",
    "runsOn": "client",
    "builtOn": [
      "ky"
    ],
    "requires": [
      "query"
    ],
    "client": true,
    "docs": "docs"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kitr/core": "workspace:*"
  },
  "peerDependencies": {
    "ky": ">=1.7.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "ky": "^2.2.0"
  },
  "keywords": [
    "kitr",
    "kitr-package"
  ]
}
