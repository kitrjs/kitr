{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@kitr/vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "#app/*": [
        "./app/*"
      ],
      "#config/*": [
        "./config/*"
      ],
      "#components/*": [
        "./app/components/*"
      ]
    }
  },
  "include": [
    "app",
    "config",
    "kitrrc.ts",
    "vite.config.ts",
    "test"
  ]
}
