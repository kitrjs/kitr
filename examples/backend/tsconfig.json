{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "#app/*": [
        "./app/*"
      ],
      "#config/*": [
        "./config/*"
      ],
      "#controllers/*": [
        "./app/controllers/*"
      ],
      "#start/*": [
        "./start/*"
      ]
    }
  },
  "include": [
    "app",
    "config",
    "start",
    "kitrrc.ts",
    "server.ts",
    "test"
  ]
}
