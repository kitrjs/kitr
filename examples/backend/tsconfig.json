{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "#app/*": [
        "./app/*"
      ],
      "#config/*": [
        "./config/*"
      ],
      "#server/*": [
        "./server/*"
      ]
    }
  },
  "include": [
    "app",
    "config",
    "server",
    "platforms",
    "kitrrc.ts",
    "test"
  ]
}
