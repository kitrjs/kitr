{
  "name": "kitr-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "manifests": "node scripts/sync-manifests.mjs",
    "manifests:check": "node scripts/sync-manifests.mjs --check",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.19.0",
    "happy-dom": "^21.0.4",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
