{
  "name": "@kitr/site",
  "private": true,
  "type": "module",
  "description": "kitr.dev: the marketing site and docs, built with kitr from each package's docs folder.",
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "node scripts/content.mjs && vite",
    "build": "node scripts/content.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/content.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@kitr/core": "workspace:*",
    "@kitr/react": "workspace:*",
    "@kitr/router": "workspace:*",
    "@kitr/state": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "kitr": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@kitr/vite": "workspace:*",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "^8.3.6"
  }
}
